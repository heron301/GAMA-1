{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/claude-sync.sh\" ] && (nohup \"$HOME/.claude/claude-sync.sh\" >/dev/null 2>&1 &) ; exit 0"
          }
        ]
      }
    ]
  }
}
